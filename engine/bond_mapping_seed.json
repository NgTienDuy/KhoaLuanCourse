  "_usage_examples": {
    "matching_a_peak": {
      "input": {"detected_peak_cm-1": 1005, "intensity": 0.85},
      "match_logic": "for entry in peaks: if abs(entry.wavenumber - 1005) <= entry.tolerance: candidates.append(entry)",
      "expected_match": "P004 (1003 ±5) → imidazole ring breathing → Histidine",
      "confidence": "high (within ±2 cm⁻¹ of center, very_strong intensity expected)"
    },
    "novelty_detection": {
      "logic": "If a detected peak has no DB match within ANY tolerance window, flag as 'unknown'. Cluster unknowns by region to localize the novel chemistry.",
      "example": "Detected peaks at 1620 and 1700 cm⁻¹ with no matches → likely C=O of ester/ketone or N-H of secondary amine → suggests external compound (perhaps tryptophan or proline)."
    }
