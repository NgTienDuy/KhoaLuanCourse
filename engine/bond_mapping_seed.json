{
  "_metadata": {
    "name": "Raman Bond Mapping Database — Seed v0.1",
    "description": "Vibrational mode assignments for 6 amino acids covered in Luca-Raman-Model dataset. Wavenumbers in cm^-1. Tolerances are typical observed shifts in mixture spectra.",
    "compounds": ["Alanine", "Glycine", "Serine", "Threonine", "Histidine", "Glucosamine"],
    "wavenumber_range_cm-1": [801.62, 1799.0],
    "version": "0.1.0-seed",
    "source_notes": "Compiled from De Gelder et al. 2007 (J. Raman Spectrosc.), Zhu et al. 2011, Socrates 'Infrared and Raman Characteristic Group Frequencies' 3rd ed., and RRUFF database cross-references. ALL ASSIGNMENTS MUST BE VERIFIED against your specific instrument calibration before use in production. This is a SEED — expand by adding entries from your own data analysis.",
    "schema_version": "1.0",
    "last_updated": "2026-05-03",
    "license": "CC BY 4.0 — please cite if used in publication"
  },

  "_schema": {
    "fields": {
      "wavenumber_cm-1": "Center wavenumber of the peak (float)",
      "tolerance_cm-1": "Acceptable matching window (±) for shifted peaks in mixtures",
      "intensity_relative": "Typical relative intensity: weak | medium | strong | very_strong",
      "vibrational_mode": "Description of the vibrational mode (e.g. 'C-C ring breathing')",
      "functional_group": "Chemical group(s) responsible",
      "compounds": "List of compounds in our 6-class set that exhibit this peak",
      "discriminative": "true if peak is highly specific to ONE compound, false if shared",
      "notes": "Additional context (overlaps, conditions, references)"
    }
  },

